{
  "name": "colsabor-inventory-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "doctor": "node scripts/doctor.mjs",
    "dev:api": "nodemon --watch ../backend --watch ../dane_core.py --watch ../inventory_core.py --ext py --exec \"cd .. && ..\\.venv\\Scripts\\python.exe -m uvicorn backend.main:app --reload --port 8000\"",
    "dev:full": "concurrently \"npm run dev:api\" \"next dev\"",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "cross-env DATABASE_URL=postgresql://user:password@localhost:5432/colsabor prisma generate",
    "prisma:validate": "cross-env DATABASE_URL=postgresql://user:password@localhost:5432/colsabor prisma validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-table": "^8.21.3",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axios": "^1.15.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "latest",
    "react": "latest",
    "react-countup": "^6.5.3",
    "react-dom": "latest",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "typescript": "latest",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "chalk": "^5.6.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.59.1",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.2.4",
    "vitest": "^4.1.5"
  }
}
